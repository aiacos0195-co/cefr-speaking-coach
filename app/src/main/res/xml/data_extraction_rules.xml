<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de respaldo para API 31+. Ver backup_rules.xml (API <= 30) para el
    porque completo: lista de INCLUSION para dejar fuera el modelo de voz de
    96 MB y los internos de Firebase.

    Las dos secciones dicen lo mismo a proposito. cloud-backup es la copia a la
    cuenta de Google; device-transfer es el paso directo de telefono a telefono.
    El de transferencia no se puede simular con bmgr, asi que la unica defensa
    es que el comportamiento sea identico por diseno.

    EL COSTO: unas SharedPreferences nuevas hay que agregarlas en las DOS
    secciones de aqui Y en backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="cefr_sessions.xml"/>
        <include domain="sharedpref" path="cefr_settings.xml"/>
        <include domain="sharedpref" path="cefr_prompt_store.xml"/>
        <include domain="sharedpref" path="sherpa_speaker_ids.xml"/>
        <include domain="sharedpref" path="ui_language_prefs.xml"/>
        <include domain="sharedpref" path="voice_download_prefs.xml"/>
    </cloud-backup>

    <device-transfer>
        <include domain="sharedpref" path="cefr_sessions.xml"/>
        <include domain="sharedpref" path="cefr_settings.xml"/>
        <include domain="sharedpref" path="cefr_prompt_store.xml"/>
        <include domain="sharedpref" path="sherpa_speaker_ids.xml"/>
        <include domain="sharedpref" path="ui_language_prefs.xml"/>
        <include domain="sharedpref" path="voice_download_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
